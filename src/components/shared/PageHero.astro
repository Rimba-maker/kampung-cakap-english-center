---
import { withBase } from "../../lib/site";
import { CaretRight } from "@phosphor-icons/react/dist/csr/CaretRight";
interface Props { title: string; subtitle?: string; image?: string; alt?: string; }
const { title, subtitle, image, alt = "Ilustrasi aktivitas belajar bersama" } = Astro.props;
---
<section class="page-hero">
  <div class="container">
    <nav class="breadcrumb" aria-label="Breadcrumb"><a href={withBase("/")}>Beranda</a><CaretRight size={11} /><span aria-current="page">{Astro.url.pathname.split("/").filter(Boolean).at(-1)?.replaceAll("-", " ")}</span></nav>
    <div class="page-hero-inner">
      <div><h1>{title}</h1>{subtitle && <p>{subtitle}</p>}</div>
      {image && <img class="photo" src={image} alt={alt} width="1200" height="800" loading="eager" />}
    </div>
  </div>
</section>
