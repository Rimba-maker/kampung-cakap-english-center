---
import { WhatsappLogo } from "@phosphor-icons/react/dist/csr/WhatsappLogo";
import { waLink } from "../../lib/site";
---

<a
  href={waLink("Halo, saya mau tanya-tanya program Kampung Cakap")}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Chat via WhatsApp"
  class="fixed bottom-5 right-5 z-40 grid h-14 w-14 place-items-center rounded-full bg-[#25D366] text-white shadow-lg shadow-black/20 transition-transform hover:scale-105 active:scale-95"
>
  <WhatsappLogo size={28} weight="fill" />
</a>
