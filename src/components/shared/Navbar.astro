---
import { List } from "@phosphor-icons/react/dist/csr/List";
import { X } from "@phosphor-icons/react/dist/csr/X";
import { CaretDown } from "@phosphor-icons/react/dist/csr/CaretDown";
import { ArrowUpRight } from "@phosphor-icons/react/dist/csr/ArrowUpRight";
import { NAV_MENU, waLink, withBase } from "../../lib/site";
const currentPath = Astro.url.pathname;
const active = (href: string) => currentPath.replace(/\/$/, "") === withBase(href).replace(/\/$/, "");
---
<header class="site-header">
  <nav class="container nav-inner" aria-label="Navigasi utama">
    <a href={withBase("/")} class="brand" aria-label="Kampung Cakap, beranda"><span class="brand-mark">KC</span>Kampung Cakap</a>
    <ul class="nav-links">
      {NAV_MENU.map(entry => <li>
        {entry.type === "link" ? <a href={withBase(entry.href)} aria-current={active(entry.href) ? "page" : undefined}>{entry.label}</a> :
          <details class="nav-dropdown">
            <summary class:list={{ "is-active": entry.items.some(item => active(item.href)) }}>{entry.label}<CaretDown size={12} weight="bold" /></summary>
            <div class="dropdown-panel">{entry.items.map(item => <a href={withBase(item.href)} aria-current={active(item.href) ? "page" : undefined}>{item.label}</a>)}</div>
          </details>
        }
      </li>)}
    </ul>
    <a href={waLink("Halo, saya mau daftar Kampung Cakap English Center")} target="_blank" rel="noopener noreferrer" class="btn btn-primary nav-cta">Daftar Sekarang<ArrowUpRight size={16} weight="bold" /></a>
    <button id="mobile-menu-btn" class="menu-toggle" type="button" aria-label="Buka menu" aria-expanded="false" aria-controls="mobile-menu">
      <List id="menu-icon-open" size={22} /><X id="menu-icon-close" size={22} className="hidden" />
    </button>
  </nav>
  <nav id="mobile-menu" class="mobile-menu" aria-label="Navigasi mobile" hidden>
    <div class="container">
      <ul>{NAV_MENU.map(entry => <li class:list={{ "mobile-group": entry.type === "group" }}>
        {entry.type === "link" ? <a href={withBase(entry.href)} aria-current={active(entry.href) ? "page" : undefined}>{entry.label}</a> : <><p>{entry.label}</p><ul>{entry.items.map(item => <li><a href={withBase(item.href)} aria-current={active(item.href) ? "page" : undefined}>{item.label}</a></li>)}</ul></>}
      </li>)}</ul>
      <a href={waLink("Halo, saya mau daftar Kampung Cakap English Center")} target="_blank" rel="noopener noreferrer" class="btn btn-primary">Daftar Sekarang<ArrowUpRight size={16} weight="bold" /></a>
    </div>
  </nav>
</header>
<script>
  const button = document.querySelector<HTMLButtonElement>("#mobile-menu-btn");
  const menu = document.querySelector<HTMLElement>("#mobile-menu");
  const openIcon = document.getElementById("menu-icon-open");
  const closeIcon = document.getElementById("menu-icon-close");
  function setMenu(open: boolean) {
    if (!button || !menu) return;
    menu.hidden = !open;
    button.setAttribute("aria-expanded", String(open));
    button.setAttribute("aria-label", open ? "Tutup menu" : "Buka menu");
    openIcon?.classList.toggle("hidden", open);
    closeIcon?.classList.toggle("hidden", !open);
  }
  button?.addEventListener("click", () => setMenu(menu?.hidden ?? true));
  const dropdowns = [...document.querySelectorAll<HTMLDetailsElement>(".nav-dropdown")];
  dropdowns.forEach(detail => detail.addEventListener("toggle", () => {
    if (detail.open) dropdowns.forEach(other => { if (other !== detail) other.open = false; });
  }));
  document.addEventListener("click", event => {
    if (!(event.target instanceof Node)) return;
    dropdowns.forEach(detail => { if (!detail.contains(event.target as Node)) detail.open = false; });
  });
  document.addEventListener("keydown", event => {
    if (event.key !== "Escape") return;
    if (menu && !menu.hidden) { setMenu(false); button?.focus(); }
    dropdowns.forEach(detail => { if (detail.open) { detail.open = false; detail.querySelector("summary")?.focus(); } });
  });
  matchMedia("(min-width: 1024px)").addEventListener("change", event => { if (event.matches) setMenu(false); });
</script>
