---
import { List } from "@phosphor-icons/react/dist/csr/List";
import { X } from "@phosphor-icons/react/dist/csr/X";
import { CaretDown } from "@phosphor-icons/react/dist/csr/CaretDown";
import { NAV_MENU, waLink, withBase } from "../../lib/site";

const currentPath = Astro.url.pathname;

function groupIsActive(items: readonly { href: string }[]) {
  return items.some((item) => withBase(item.href) === currentPath);
}
---

<header class="sticky top-0 z-40 border-b border-primary-100 bg-white/90 backdrop-blur">
  <nav class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 md:h-20 md:px-8">
    <a href={withBase("/")} class="flex items-center gap-2 text-lg font-extrabold tracking-tight text-primary-900 md:text-xl">
      <span class="blob-2 flex h-9 w-9 items-center justify-center bg-primary-400 text-sm font-extrabold text-white">
        KC
      </span>
      Kampung Cakap
    </a>

    <ul class="hidden items-center gap-1 lg:flex">
      {
        NAV_MENU.map((entry) =>
          entry.type === "link" ? (
            <li>
              <a
                href={withBase(entry.href)}
                class:list={[
                  "whitespace-nowrap rounded-full px-3 py-2 text-sm font-medium text-ink/70 transition-colors hover:text-primary-600",
                  currentPath === withBase(entry.href) && "text-primary-600",
                ]}
              >
                {entry.label}
              </a>
            </li>
          ) : (
            <li class="group relative">
              <button
                type="button"
                class:list={[
                  "flex items-center gap-1 whitespace-nowrap rounded-full px-3 py-2 text-sm font-medium text-ink/70 transition-colors hover:text-primary-600",
                  groupIsActive(entry.items) && "text-primary-600",
                ]}
              >
                {entry.label}
                <CaretDown size={13} weight="bold" className="transition-transform duration-200 group-hover:rotate-180 group-focus-within:rotate-180" />
              </button>

              <div class="invisible absolute left-0 top-full w-60 pt-2 opacity-0 transition-all duration-150 group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100">
                <div class="rounded-2xl border border-primary-100 bg-white p-2 shadow-lg">
                  {entry.items.map((item) => (
                    <a
                      href={withBase(item.href)}
                      class:list={[
                        "block rounded-xl px-3 py-2.5 text-sm font-medium text-ink/75 transition-colors hover:bg-primary-50 hover:text-primary-600",
                        currentPath === withBase(item.href) && "bg-primary-50 text-primary-600",
                      ]}
                    >
                      {item.label}
                    </a>
                  ))}
                </div>
              </div>
            </li>
          ),
        )
      }
    </ul>

    <a
      href={waLink("Halo, saya mau daftar Kampung Cakap English Center")}
      target="_blank"
      rel="noopener noreferrer"
      class="hidden rounded-full bg-cta px-5 py-2.5 text-sm font-bold text-white transition-transform active:scale-[0.98] lg:inline-block"
    >
      Daftar Sekarang
    </a>

    <button
      id="mobile-menu-btn"
      class="grid h-10 w-10 place-items-center rounded-full border border-primary-100 text-ink lg:hidden"
      aria-label="Buka menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <List id="menu-icon-open" size={22} weight="bold" />
      <X id="menu-icon-close" size={22} weight="bold" className="hidden" />
    </button>
  </nav>

  <div id="mobile-menu" class="hidden max-h-[calc(100dvh-4rem)] overflow-y-auto border-t border-primary-100 bg-white lg:hidden">
    <ul class="flex flex-col gap-1 px-4 py-3">
      {
        NAV_MENU.map((entry) =>
          entry.type === "link" ? (
            <li>
              <a href={withBase(entry.href)} class="block rounded-lg px-3 py-2 text-sm font-medium text-ink/80 hover:bg-primary-50">
                {entry.label}
              </a>
            </li>
          ) : (
            <li class="pt-2">
              <p class="px-3 text-xs font-bold uppercase tracking-wide text-ink/40">{entry.label}</p>
              <ul class="mt-1">
                {entry.items.map((item) => (
                  <li>
                    <a href={withBase(item.href)} class="block rounded-lg px-3 py-2 text-sm font-medium text-ink/80 hover:bg-primary-50">
                      {item.label}
                    </a>
                  </li>
                ))}
              </ul>
            </li>
          ),
        )
      }
      <li class="pt-2">
        <a
          href={waLink("Halo, saya mau daftar Kampung Cakap English Center")}
          target="_blank"
          rel="noopener noreferrer"
          class="block rounded-full bg-cta px-4 py-2.5 text-center text-sm font-bold text-white"
        >
          Daftar Sekarang
        </a>
      </li>
    </ul>
  </div>
</header>

<script>
  const btn = document.getElementById("mobile-menu-btn");
  const menu = document.getElementById("mobile-menu");
  const iconOpen = document.getElementById("menu-icon-open");
  const iconClose = document.getElementById("menu-icon-close");
  btn?.addEventListener("click", () => {
    const isOpen = menu?.classList.toggle("hidden") === false;
    btn.setAttribute("aria-expanded", String(isOpen));
    iconOpen?.classList.toggle("hidden", isOpen);
    iconClose?.classList.toggle("hidden", !isOpen);
  });
</script>
