---
import { InstagramLogo } from "@phosphor-icons/react/dist/csr/InstagramLogo";
import { TiktokLogo } from "@phosphor-icons/react/dist/csr/TiktokLogo";
import { YoutubeLogo } from "@phosphor-icons/react/dist/csr/YoutubeLogo";
import { WhatsappLogo } from "@phosphor-icons/react/dist/csr/WhatsappLogo";
import { EnvelopeSimple } from "@phosphor-icons/react/dist/csr/EnvelopeSimple";
import { MapPin } from "@phosphor-icons/react/dist/csr/MapPin";
import { NAV_LINKS, waLink, withBase } from "../../lib/site";
---

<footer class="relative overflow-hidden border-t border-white/10 bg-primary-950 text-white">
  <div class="mx-auto max-w-7xl px-4 py-16 md:px-8 md:py-20">
    <div class="grid gap-12 md:grid-cols-[1.2fr_1fr_1fr]">
      <div>
        <a href={withBase("/")} class="flex items-center gap-2 text-xl font-extrabold">
          <span class="blob-2 flex h-9 w-9 items-center justify-center bg-accent-yellow text-sm font-extrabold text-primary-900">
            KC
          </span>
          Kampung Cakap
        </a>
        <p class="mt-4 max-w-xs text-sm text-white/70">
          Cakap 24 Jam, Bukan Kelas 2 Jam. Kursus bahasa Inggris immersive dengan sistem asrama wajib berbahasa Inggris 24 jam.
        </p>
        <div class="mt-6 flex gap-3">
          <a href="#" aria-label="Instagram" class="grid h-9 w-9 place-items-center rounded-full bg-white/10 transition-colors hover:bg-white/20">
            <InstagramLogo size={18} />
          </a>
          <a href="#" aria-label="TikTok" class="grid h-9 w-9 place-items-center rounded-full bg-white/10 transition-colors hover:bg-white/20">
            <TiktokLogo size={18} />
          </a>
          <a href="#" aria-label="YouTube" class="grid h-9 w-9 place-items-center rounded-full bg-white/10 transition-colors hover:bg-white/20">
            <YoutubeLogo size={18} />
          </a>
        </div>
      </div>

      <div>
        <p class="text-sm font-bold uppercase tracking-wide text-white/50">Halaman</p>
        <ul class="mt-4 grid gap-2.5">
          {
            NAV_LINKS.map((link) => (
              <li>
                <a href={withBase(link.href)} class="text-sm text-white/80 hover:text-white">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <p class="text-sm font-bold uppercase tracking-wide text-white/50">Kontak</p>
        <ul class="mt-4 grid gap-3 text-sm text-white/80">
          <li class="flex items-start gap-2">
            <WhatsappLogo size={18} className="mt-0.5 shrink-0" />
            <a href={waLink("Halo, saya mau tanya-tanya Kampung Cakap")} target="_blank" rel="noopener noreferrer" class="hover:text-white">
              +62 812-3456-7890
            </a>
          </li>
          <li class="flex items-start gap-2">
            <EnvelopeSimple size={18} className="mt-0.5 shrink-0" />
            <span>halo@kampungcakap.id</span>
          </li>
          <li class="flex items-start gap-2">
            <MapPin size={18} className="mt-0.5 shrink-0" />
            <span>Pare, Kediri, Jawa Timur</span>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-12 border-t border-white/10 pt-6 text-xs text-white/50">
      <p>
        Terdaftar SK Diknas No. [isi sesuai dokumen] &middot; NPSN [isi sesuai dokumen]
      </p>
      <p class="mt-1">&copy; {new Date().getFullYear()} Kampung Cakap English Center.</p>
    </div>
  </div>
</footer>
