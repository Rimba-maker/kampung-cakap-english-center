---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/shared/PageHero.astro";
import { waLink, withBase } from "../lib/site";
import { photo } from "../lib/photos";

const packages = [
  { duration: "2 Minggu", type: "Trial", price: "Rp 850.000", goal: "Coba dulu, liburan singkat" },
  { duration: "1 Bulan", type: "Reguler", price: "Rp 1.500.000", goal: "Program reguler paling populer dalam rancangan paket" },
  { duration: "2 Bulan", type: "Lanjutan", price: "Rp 2.700.000", goal: "Confidence + Active sekaligus" },
  { duration: "3 Bulan", type: "Intensif", price: "Rp 3.800.000", goal: "Sampai level Fluent" },
  { duration: "6 Bulan", type: "Lengkap", price: "Rp 6.500.000", goal: "Dari nol sampai Fluent/TOEFL lengkap" },
];
const included = ["Modul belajar", "Kaos", "Sertifikat kelulusan", "Kartu member"];
---

<Layout title="Harga & Paket Kursus - Kampung Cakap English Center" description="Paket kursus bahasa Inggris mulai 2 minggu hingga 6 bulan. Harga transparan, termasuk modul dan sertifikat.">
  <PageHero title="Pilih Paket Sesuai Waktu dan Tujuanmu." subtitle="Dari dua minggu untuk mencoba sampai enam bulan untuk belajar lebih lengkap. Bandingkan biaya kursus, lalu rencanakan tempat tinggal secara terpisah." image={photo("books")} alt="Ilustrasi buku dan bahan belajar untuk kursus" />

  <section class="section">
    <div class="container">
      <div class="pricing-heading"><div><h2 class="section-heading">Lima durasi. Satu arah: makin cakap.</h2><p class="section-intro">Semakin lama durasi, semakin banyak ruang untuk latihan dan progres. Pilih sesuai waktu dan tujuan belajarmu.</p></div><a class="text-link" href={withBase("/program/")}>Bandingkan jenjang program</a></div>
      <p class="notice estimate-notice" id="catatan-harga">Seluruh harga adalah estimasi draf, bukan penawaran final. Konfirmasi biaya nyata dan ketersediaan sebelum mendaftar atau melakukan pembayaran.</p>
      <div class="course-price-scroll" role="region" aria-label="Perbandingan estimasi biaya kursus, dapat digeser pada layar kecil" tabindex="0">
        <table aria-describedby="catatan-harga"><caption>Estimasi biaya kursus, belum termasuk asrama atau kos</caption><thead><tr><th scope="col">Durasi belajar</th><th scope="col">Estimasi kursus</th><th scope="col">Cocok untuk</th><th scope="col"><span class="sr-only">Konsultasi paket</span></th></tr></thead><tbody>{packages.map((pkg) => <tr><th scope="row"><strong>{pkg.duration}</strong><span>{pkg.type}</span></th><td class="course-price">{pkg.price}</td><td>{pkg.goal}</td><td><a class="text-link" href={waLink(`Halo, saya ingin konsultasi paket ${pkg.duration} Kampung Cakap dan konfirmasi biaya kursus serta asrama`)} target="_blank" rel="noopener noreferrer">Tanya paket<span class="sr-only"> {pkg.duration}</span></a></td></tr>)}</tbody></table>
      </div>
      <p class="small-note">Kecocokan paket adalah panduan, bukan jaminan mencapai level tertentu. Jenjang dan durasi bisa didiskusikan saat konsultasi.</p>
    </div>
  </section>

  <section class="section section-soft">
    <div class="container content-grid inclusions-section">
      <figure><img class="photo" src={photo("materials")} alt="Ilustrasi perlengkapan dan bahan belajar" width="1200" height="800" loading="lazy" /><figcaption>Ilustrasi bahan belajar dari Pexels, bukan foto isi paket asli.</figcaption></figure>
      <div><h2 class="section-heading">Yang termasuk dalam paket kursus.</h2><p class="section-intro">Empat perlengkapan berikut tercantum dalam rancangan paket. Sertifikat kelulusan diberikan sesuai jenjang yang kamu ambil.</p><ul class="inclusions">{included.map((item) => <li>{item}</li>)}</ul><p class="small-note">Wisata weekend tidak otomatis termasuk paket atau kurikulum. Laundry merupakan layanan tambahan opsional.</p></div>
    </div>
  </section>

  <section class="section" id="biaya-tempat-tinggal">
    <div class="container">
      <h2 class="section-heading">Biaya tinggal, dihitung terpisah.</h2><p class="section-intro">Estimasi berikut dibayar per bulan dan tidak masuk ke harga kursus di atas. Pilih sesuai preferensi berbagi kamar.</p>
      <div class="housing-prices">
        <article><img class="photo" src={photo("dorm-room")} alt="Ilustrasi kamar akomodasi bersama" width="1200" height="800" loading="lazy" /><div class="housing-title"><h3>Asrama</h3><span>4–5 orang / kamar</span></div><p class="housing-price">Rp 400.000–600.000 <span>/ bulan</span></p><p>Pengalaman tinggal dengan lebih banyak teman sekamar.</p></article>
        <article><img class="photo" src={photo("dorm-study")} alt="Ilustrasi ruang tinggal dan belajar yang lebih privat" width="1200" height="800" loading="lazy" /><div class="housing-title"><h3>Kos</h3><span>2–3 orang / kamar</span></div><p class="housing-price">Rp 600.000–900.000 <span>/ bulan</span></p><p>Pilihan lebih privat, tetap mengikuti jadwal program penuh.</p></article>
      </div>
      <div class="housing-note"><p class="small-note">Foto Pexels sebagai ilustrasi ruang, bukan dokumentasi asrama atau kos Kampung Cakap. Biaya tinggal juga merupakan estimasi draf.</p><a class="text-link" href={withBase("/asrama-english-area/")}>Baca aturan & fasilitas kamar</a></div>
    </div>
  </section>

  <section class="section section-soft">
    <div class="container payment-layout"><div><h2 class="section-heading">Pembayaran tanpa tanda tanya.</h2><p class="section-intro">Pastikan program, biaya final, dan intake sudah disepakati sebelum membayar.</p></div><dl class="payment-details"><div><dt>DP minimal 50%</dt><dd>Untuk mengunci slot batch yang dipilih.</dd></div><div><dt>Pelunasan sebelum / saat mulai</dt><dd>Sisa pembayaran dilunasi sebelum atau saat program dimulai.</dd></div><div><dt>Transfer bank atau QRIS</dt><dd>Detail rekening dan QRIS resmi harus dikonfirmasi melalui kontak resmi. Halaman ini tidak menerima pembayaran.</dd></div></dl></div>
  </section>

  <section class="section"><div class="container cta-panel"><h2 class="section-heading">Rencanakan paket dan tempat tinggal sekaligus.</h2><p class="section-intro">Ceritakan waktu yang kamu punya dan tujuan belajarmu. Tanyakan biaya final serta ketersediaan intake sebelum memilih.</p><div class="closing-actions"><a class="btn btn-primary" href={waLink("Halo, saya mau cek ketersediaan dan konsultasi paket Kampung Cakap")} target="_blank" rel="noopener noreferrer">Cek Ketersediaan & Konsultasi Paket</a><a class="btn btn-secondary" href={withBase("/pendaftaran/")}>Lihat cara daftar</a></div><p class="small-note">WhatsApp memakai nomor demonstrasi, bukan kontak resmi yang terverifikasi. Jangan mengirim pembayaran ke nomor demo.</p></div></section>
</Layout>

<style>
  .pricing-heading { display: flex; align-items: end; justify-content: space-between; gap: 32px; }
  .pricing-heading > div { max-width: 760px; }
  .pricing-heading > a { flex-shrink: 0; }
  .estimate-notice { margin-top: 28px; font-size: .9rem; line-height: 1.7; }
  .course-price-scroll { position: relative; overflow-x: auto; margin-top: 32px; scrollbar-color: #0284c7 #e8f5fc; }
  table { width: 100%; border-collapse: collapse; min-width: 720px; text-align: left; }
  caption { text-align: left; color: #07557c; font-size: .9rem; font-weight: 600; padding-bottom: 18px; }
  thead { background: #f4f9fc; }
  th, td { padding: 22px 20px; border-bottom: 1px solid #dce5eb; vertical-align: middle; }
  thead th { font-size: .85rem; font-weight: 600; color: #465966; }
  tbody th { width: 20%; color: #172b3a; }
  tbody th strong { font-size: 1.15rem; }
  tbody th span { display: block; margin-top: 5px; color: #5a6b77; font-size: .85rem; font-weight: 400; }
  td { color: #465966; font-size: .95rem; line-height: 1.6; }
  td.course-price { color: #07557c; font-size: 1.2rem; font-weight: 700; white-space: nowrap; font-variant-numeric: tabular-nums; }
  tbody tr:nth-child(2) { background: #f4f9fc; }
  td:last-child { white-space: nowrap; }
  td a { display: inline-flex; align-items: center; min-height: 44px; }
  .small-note, figcaption { margin-top: 16px; color: #5a6b77; font-size: .8rem; line-height: 1.65; }
  figure { margin: 0; }
  .inclusions-section { align-items: center; }
  .inclusions-section img { aspect-ratio: 5 / 4; height: auto; }
  .inclusions { list-style: none; padding: 0; margin: 28px 0; display: grid; grid-template-columns: 1fr 1fr; gap: 0 28px; }
  .inclusions li { color: #172b3a; border-bottom: 1px solid #dce5eb; padding: 16px 0; font-weight: 600; }
  #biaya-tempat-tinggal { scroll-margin-top: 100px; }
  .housing-prices { display: grid; grid-template-columns: 1fr 1fr; gap: 32px; margin-top: 36px; }
  .housing-prices img { aspect-ratio: 2 / 1; height: auto; }
  .housing-title { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px; margin-top: 22px; }
  .housing-title h3 { font-size: 1.5rem; color: #172b3a; font-weight: 700; }
  .housing-title span { color: #5a6b77; font-size: .9rem; }
  .housing-prices p { margin-top: 10px; color: #465966; line-height: 1.7; }
  .housing-prices .housing-price { color: #07557c; font-weight: 700; font-size: clamp(1.2rem, 2vw, 1.6rem); font-variant-numeric: tabular-nums; }
  .housing-price span { font-size: .9rem; font-weight: 400; color: #465966; }
  .housing-note { display: flex; justify-content: space-between; align-items: start; gap: 32px; margin-top: 26px; }
  .housing-note p { margin-top: 0; max-width: 700px; }
  .housing-note a { flex-shrink: 0; }
  .payment-layout { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; }
  .payment-details { margin: 0; }
  .payment-details div { padding: 20px 0; border-bottom: 1px solid #dce5eb; }
  .payment-details div:first-child { padding-top: 0; }
  .payment-details dt { color: #172b3a; font-weight: 700; font-size: 1.1rem; }
  .payment-details dd { margin: 8px 0 0; color: #465966; line-height: 1.75; }
  .closing-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 26px; }
  @media (max-width: 900px) { .pricing-heading, .housing-note { display: block; } .pricing-heading > a, .housing-note a { display: inline-block; margin-top: 20px; } }
  @media (max-width: 767px) { .housing-prices, .payment-layout { grid-template-columns: 1fr; gap: 36px; } .inclusions { grid-template-columns: 1fr; } th, td { padding: 18px 16px; } }
</style>
