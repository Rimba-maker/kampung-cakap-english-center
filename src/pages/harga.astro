---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/shared/PageHero.astro";
import BlobDivider from "../components/shared/BlobDivider.astro";
import PricingGrid from "../components/harga/PricingGrid";
import { CheckCircle } from "@phosphor-icons/react/dist/csr/CheckCircle";
import { QrCode } from "@phosphor-icons/react/dist/csr/QrCode";
import { Bank } from "@phosphor-icons/react/dist/csr/Bank";
import { waLink } from "../lib/site";

const included = ["Modul belajar", "Kaos", "Sertifikat kelulusan", "Kartu member"];
---

<Layout
  title="Harga & Paket Kursus - Kampung Cakap English Center"
  description="Paket kursus bahasa Inggris mulai 2 minggu hingga 6 bulan. Harga transparan, termasuk modul dan sertifikat."
>
  <PageHero
    title="Pilih Paket Sesuai Waktu dan Tujuanmu."
    subtitle="Semakin lama durasi, semakin banyak progres yang bisa dicapai."
  />
  <BlobDivider class="text-white -mt-1" />

  <section class="mx-auto max-w-5xl px-4 py-16 md:px-8 md:py-20">
    <PricingGrid client:visible />

    <div class="mt-10 rounded-2xl bg-primary-50 p-6">
      <p class="text-sm font-bold text-primary-900">Termasuk dalam paket</p>
      <div class="mt-3 flex flex-wrap gap-x-6 gap-y-2">
        {
          included.map((item) => (
            <span class="flex items-center gap-1.5 text-sm text-ink/70">
              <CheckCircle size={16} weight="fill" className="text-primary-500" />
              {item}
            </span>
          ))
        }
      </div>
    </div>
  </section>

  <section class="bg-primary-50/60 py-16 md:py-20">
    <div class="mx-auto max-w-5xl px-4 md:px-8">
      <h2 class="text-2xl font-extrabold tracking-tight text-primary-900 md:text-3xl">Biaya Asrama/Kos</h2>
      <p class="mt-1 text-sm text-ink/60">Terpisah dari biaya kursus, dibayar per bulan.</p>

      <div class="mt-8 grid gap-6 sm:grid-cols-2">
        <div class="rounded-2xl border border-primary-100 bg-white p-6">
          <p class="text-base font-bold text-primary-900">Asrama</p>
          <p class="text-xs text-ink/50">4-5 orang per kamar</p>
          <p class="mt-3 text-xl font-extrabold text-primary-600">Rp 400.000 - 600.000</p>
        </div>
        <div class="rounded-2xl border border-primary-100 bg-white p-6">
          <p class="text-base font-bold text-primary-900">Kos</p>
          <p class="text-xs text-ink/50">2-3 orang per kamar, lebih privat</p>
          <p class="mt-3 text-xl font-extrabold text-primary-600">Rp 600.000 - 900.000</p>
        </div>
      </div>

      <div class="mt-8 flex flex-wrap items-center gap-6 rounded-2xl border border-primary-100 bg-white p-6">
        <div class="flex items-center gap-2 text-sm text-ink/70">
          <Bank size={20} className="text-primary-600" />
          Transfer bank atau
          <QrCode size={20} className="text-primary-600" />
          QRIS
        </div>
        <p class="text-sm text-ink/70">DP minimal 50%, pelunasan sebelum/saat program dimulai.</p>
      </div>

      <p class="mt-6 text-sm italic leading-relaxed text-ink/50">
        Catatan: seluruh angka bersifat estimasi untuk keperluan draf, wajib disesuaikan dengan struktur biaya nyata sebelum digunakan.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-4 py-16 text-center md:px-8 md:py-20">
    <h2 class="text-2xl font-extrabold tracking-tight text-primary-900 md:text-3xl">Masih Ragu Pilih Paket Mana?</h2>
    <a
      href={waLink("Halo, saya mau cek ketersediaan dan konsultasi paket Kampung Cakap")}
      target="_blank"
      rel="noopener noreferrer"
      class="mt-6 inline-block rounded-full bg-cta px-7 py-3.5 text-sm font-bold text-white transition-transform active:scale-[0.98]"
    >
      Cek Ketersediaan & Konsultasi Paket
    </a>
  </section>
</Layout>
