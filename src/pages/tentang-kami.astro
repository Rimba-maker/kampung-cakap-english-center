---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/shared/PageHero.astro";
import BlobDivider from "../components/shared/BlobDivider.astro";
import { CalendarBlank } from "@phosphor-icons/react/dist/csr/CalendarBlank";
import { GraduationCap } from "@phosphor-icons/react/dist/csr/GraduationCap";
import { SealCheck } from "@phosphor-icons/react/dist/csr/SealCheck";
import { ChalkboardTeacher } from "@phosphor-icons/react/dist/csr/ChalkboardTeacher";
import { pexelsPhoto, PHOTOS, waLink } from "../lib/site";

const stats = [
  { icon: CalendarBlank, label: "Berdiri Sejak", value: "[Tahun]" },
  { icon: GraduationCap, label: "Alumni", value: "2.000+" },
  { icon: SealCheck, label: "Legalitas", value: "SK Diknas" },
  { icon: ChalkboardTeacher, label: "Tutor Berpengalaman", value: "[X]" },
];
---

<Layout
  title="Tentang Kampung Cakap English Center"
  description="Kampung Cakap English Center percaya cara tercepat belajar bahasa adalah dengan hidup di dalamnya, bukan sekadar menghafal grammar di kelas."
>
  <PageHero
    title="Tentang Kampung Cakap."
    subtitle="Bukan sekolah bahasa biasa. Kami percaya cara tercepat cakap Inggris adalah hidup di dalamnya."
  />
  <BlobDivider class="text-white -mt-1" />

  <section class="mx-auto max-w-5xl px-4 py-16 md:px-8 md:py-20">
    <div class="grid items-center gap-10 md:grid-cols-2">
      <p class="text-base leading-relaxed text-ink/70 md:text-lg">
        Kampung Cakap English Center berdiri sejak <strong class="text-primary-900">[isi tahun]</strong> dari satu keyakinan sederhana: bahasa paling cepat dikuasai kalau dipakai tiap hari, bukan dihafal di kelas. Sistem immersive kami memaksa otak kamu mikir dalam bahasa Inggris dari bangun sampai tidur lagi, tanpa kehilangan keseruan hidup bareng teman-teman satu asrama.
      </p>
      <img
        src={pexelsPhoto(PHOTOS.teamTutor, 900)}
        alt="Tim tutor Kampung Cakap bersama peserta"
        class="aspect-[4/3] w-full rounded-3xl object-cover shadow-lg"
      />
    </div>

    <div class="mt-12 grid grid-cols-2 gap-6 md:grid-cols-4">
      {
        stats.map(({ icon: IconEl, label, value }) => (
          <div class="rounded-2xl border border-primary-100 bg-white p-5 text-center">
            <span class="blob-2 mx-auto grid h-11 w-11 place-items-center bg-primary-400/15 text-primary-600">
              <IconEl size={20} weight="bold" />
            </span>
            <p class="mt-3 text-lg font-extrabold text-primary-900">{value}</p>
            <p class="mt-1 text-xs text-ink/50">{label}</p>
          </div>
        ))
      }
    </div>

    <div class="mt-10 rounded-2xl bg-primary-50 p-6 text-sm text-ink/70">
      <p class="font-bold text-primary-900">Legalitas</p>
      <p class="mt-1.5">SK Diknas No. [isi sesuai dokumen] &middot; NPSN [isi sesuai dokumen]</p>
    </div>

    <div class="mt-12 text-center">
      <h2 class="text-2xl font-extrabold tracking-tight text-primary-900 md:text-3xl">
        Siap Jadi Bagian Cerita Kami Berikutnya?
      </h2>
      <a
        href={waLink("Halo, saya mau kenalan lebih jauh sama Kampung Cakap")}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-6 inline-block rounded-full bg-cta px-7 py-3.5 text-sm font-bold text-white transition-transform active:scale-[0.98]"
      >
        Daftar Sekarang
      </a>
    </div>
  </section>
</Layout>
