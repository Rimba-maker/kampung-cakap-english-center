---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/shared/PageHero.astro";
import BlobDivider from "../components/shared/BlobDivider.astro";
import FaqAccordion from "../components/faq/FaqAccordion";
import { waLink } from "../lib/site";
---

<Layout
  title="Pertanyaan Umum - Kampung Cakap English Center"
  description="Jawaban lengkap seputar program, asrama, dan sistem English Area."
>
  <PageHero
    title="Pertanyaan Umum."
    subtitle="Masih ragu? Ini jawaban buat pertanyaan yang paling sering ditanyain calon peserta."
  />
  <BlobDivider class="text-white -mt-1" />

  <section class="mx-auto max-w-3xl px-4 py-16 md:px-8 md:py-20">
    <FaqAccordion client:visible />

    <div class="mt-12 rounded-2xl bg-primary-50 p-6 text-center">
      <p class="text-sm font-semibold text-primary-900">Pertanyaanmu belum kejawab?</p>
      <a
        href={waLink("Halo, saya mau tanya-tanya soal Kampung Cakap")}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-3 inline-block text-sm font-bold text-cta hover:underline"
      >
        Tanya Langsung via WhatsApp
      </a>
    </div>
  </section>
</Layout>
