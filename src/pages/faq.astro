---
import Layout from "../layouts/Layout.astro";
import FaqAccordion from "../components/faq/FaqAccordion";
import { photo } from "../lib/photos";
import { waLink, withBase } from "../lib/site";
---

<Layout title="Pertanyaan Umum - Kampung Cakap English Center" description="Jawaban lengkap seputar program, asrama, dan sistem English Area.">
  <header class="faq-header section section-soft"><div class="container faq-heading"><div><h1>Pertanyaan Umum.</h1><p>Mulai dengan informasi yang jelas. Temukan jawaban tentang program, asrama, dan keseharian di English Area sebelum kamu mendaftar.</p><a class="text-link" href="#jawaban">Baca semua jawaban</a></div><figure><img class="photo" src={photo("notebook")} alt="Ilustrasi catatan dan perlengkapan belajar dari Pexels" width="1200" height="800" fetchpriority="high" /><figcaption>Foto ilustrasi Pexels.</figcaption></figure></div></header>

  <section class="section faq-content" id="jawaban">
    <div class="container faq-layout">
      <aside class="faq-guide"><h2 class="section-heading">Sebelum berkemas.</h2><p>Hal-hal praktis yang perlu kamu tahu, dari pilihan tinggal sampai langkah setelah evaluasi.</p><img class="photo" src={photo("reading")} alt="Ilustrasi seseorang membaca dan mempersiapkan kegiatan belajar" width="1200" height="800" loading="lazy" /><p class="photo-note">Foto ilustrasi Pexels, bukan dokumentasi peserta.</p><a class="text-link" href={withBase("/pendaftaran/")}>Lihat jadwal & cara daftar</a></aside>
      <div><FaqAccordion /><div class="notice faq-reminder"><strong>Konfirmasi sebelum mendaftar.</strong><p>Jawaban mengikuti rancangan program. Detail kebijakan, ketersediaan, harga, serta kontak resmi perlu dikonfirmasi sebelum pembayaran.</p></div></div>
    </div>
  </section>

  <section class="section section-soft"><div class="container faq-close"><div><h2 class="section-heading">Pertanyaanmu belum kejawab?</h2><p>Tujuan dan kebutuhan setiap peserta bisa berbeda. Bawa pertanyaanmu ke percakapan konsultasi.</p></div><div><a class="btn btn-primary" href={waLink("Halo, saya mau tanya-tanya soal Kampung Cakap")} target="_blank" rel="noopener noreferrer">Tanya via WhatsApp</a><p class="demo-note">Nomor WhatsApp masih demonstrasi, bukan kontak resmi terverifikasi.</p></div></div></section>
</Layout>

<style>
  .faq-heading { display: grid; grid-template-columns: 1.1fr .9fr; gap: 64px; align-items: center; }
  h1 { font-size: clamp(2.6rem, 5.2vw, 5rem); line-height: 1.08; letter-spacing: -.04em; color: #172b3a; }
  .faq-heading > div > p { font-size: 1.12rem; max-width: 54ch; margin: 24px 0; }
  .faq-heading figure { margin: 0; }
  .faq-heading img { aspect-ratio: 16 / 11; }
  figcaption, .photo-note { font-size: .8rem; color: #5a6b77; margin-top: 12px; }
  .faq-layout { display: grid; grid-template-columns: .65fr 1.35fr; gap: 72px; align-items: start; }
  .faq-guide > p { margin-top: 18px; }
  .faq-guide img { aspect-ratio: 4 / 3; margin-top: 28px; }
  .faq-guide .photo-note { margin-top: 12px; }
  .faq-guide > a { display: inline-block; margin-top: 22px; }
  .faq-content :global(.faq-item) { border-top: 1px solid #dce5eb; }
  .faq-content :global(.faq-item:last-child) { border-bottom: 1px solid #dce5eb; }
  .faq-content :global(summary) { display: flex; gap: 20px; align-items: center; justify-content: space-between; padding: 24px 4px; font-size: 1.02rem; line-height: 1.55; font-weight: 700; color: #172b3a; cursor: pointer; list-style: none; }
  .faq-content :global(summary::-webkit-details-marker) { display: none; }
  .faq-content :global(summary:hover) { color: #07557c; }
  .faq-content :global(summary svg) { flex-shrink: 0; color: #07557c; }
  .faq-content :global(details[open] summary) { color: #07557c; }
  .faq-content :global(details[open] summary svg) { transform: rotate(180deg); }
  .faq-content :global(.faq-item > p) { padding: 0 36px 26px 4px; color: #465966; line-height: 1.8; }
  .faq-reminder { margin-top: 32px; font-size: .88rem; }
  .faq-reminder p { margin-top: 10px; }
  .faq-close { display: grid; grid-template-columns: 1.3fr .7fr; gap: 64px; align-items: center; }
  .faq-close > div > p { margin-top: 18px; max-width: 60ch; }
  .faq-close .demo-note { font-size: .8rem; color: #5a6b77; max-width: 36ch; }
  @media (max-width: 767px) { .faq-heading, .faq-layout, .faq-close { grid-template-columns: 1fr; gap: 30px; } .faq-guide img { display: block; max-height: 220px; } .faq-content :global(summary) { padding-block: 22px; font-size: .95rem; } }
</style>
