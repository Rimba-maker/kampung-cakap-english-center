---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/shared/PageHero.astro";
import BlobDivider from "../components/shared/BlobDivider.astro";
import { WhatsappLogo } from "@phosphor-icons/react/dist/csr/WhatsappLogo";
import { ClipboardText } from "@phosphor-icons/react/dist/csr/ClipboardText";
import { CurrencyCircleDollar } from "@phosphor-icons/react/dist/csr/CurrencyCircleDollar";
import { CalendarCheck } from "@phosphor-icons/react/dist/csr/CalendarCheck";
import { IdentificationCard } from "@phosphor-icons/react/dist/csr/IdentificationCard";
import { Image } from "@phosphor-icons/react/dist/csr/Image";
import { Backpack } from "@phosphor-icons/react/dist/csr/Backpack";
import { waLink } from "../lib/site";
import { getUpcomingIntakes, formatIndoDate } from "../lib/intake-schedule";

const intakes = getUpcomingIntakes(2);

const steps = [
  { icon: WhatsappLogo, title: "Hubungi via WhatsApp", body: "Pilih program dan durasi yang kamu mau." },
  { icon: ClipboardText, title: "Isi Formulir Pendaftaran", body: "Bisa online atau langsung di lokasi." },
  { icon: CurrencyCircleDollar, title: "Bayar DP Minimal 50%", body: "Untuk mengunci slot batch pilihanmu." },
  { icon: CalendarCheck, title: "Datang di Tanggal Intake", body: "Langsung mulai orientasi dan kelas." },
];

const bawaan = [
  { icon: IdentificationCard, label: "Fotokopi KTP/Kartu Pelajar" },
  { icon: Image, label: "Pas foto" },
  { icon: Backpack, label: "Perlengkapan pribadi untuk tinggal (jika ambil asrama/kos)" },
];
---

<Layout
  title="Jadwal & Cara Daftar - Kampung Cakap English Center"
  description="Pendaftaran batch setiap tanggal 10 dan 25 tiap bulan. Cara daftar, syarat, dan yang perlu dibawa saat datang."
>
  <PageHero
    title="Kapan Bisa Mulai?"
    subtitle="Nggak perlu nunggu lama, tinggal pilih tanggal batch dan langsung gas."
  />
  <BlobDivider class="text-white -mt-1" />

  <section class="mx-auto max-w-3xl px-4 py-16 md:px-8 md:py-20">
    <div class="rounded-3xl bg-primary-900 p-8 text-center text-white md:p-10">
      <p class="text-sm font-semibold text-white/60">Batch berikutnya buka tanggal</p>
      <div class="mt-3 flex flex-wrap items-center justify-center gap-4">
        {
          intakes.map((date) => (
            <span class="rounded-full bg-white/10 px-5 py-2.5 text-lg font-extrabold text-accent-yellow">
              {formatIndoDate(date)}
            </span>
          ))
        }
      </div>
      <p class="mt-4 text-sm text-white/60">Daftar sebelum tanggal tersebut untuk ikut batch berikutnya.</p>
    </div>
  </section>

  <section class="bg-primary-50/60 py-16 md:py-20">
    <div class="mx-auto max-w-4xl px-4 md:px-8">
      <h2 class="text-2xl font-extrabold tracking-tight text-primary-900 md:text-3xl">Cara Daftar</h2>

      <div class="mt-8 grid gap-6 sm:grid-cols-2">
        {
          steps.map(({ icon: IconEl, title, body }, i) => (
            <div class="relative rounded-2xl border border-primary-100 bg-white p-6">
              <span class="absolute -top-3 -left-3 grid h-8 w-8 place-items-center rounded-full bg-cta text-sm font-extrabold text-white">
                {i + 1}
              </span>
              <span class="blob-2 grid h-12 w-12 place-items-center bg-primary-400/15 text-primary-600">
                <IconEl size={22} weight="bold" />
              </span>
              <h3 class="mt-4 text-base font-bold text-primary-900">{title}</h3>
              <p class="mt-1.5 text-sm leading-relaxed text-ink/65">{body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-4 py-16 md:px-8 md:py-20">
    <h2 class="text-2xl font-extrabold tracking-tight text-primary-900 md:text-3xl">Yang Perlu Dibawa Saat Datang</h2>
    <div class="mt-6 grid gap-3 sm:grid-cols-3">
      {
        bawaan.map(({ icon: IconEl, label }) => (
          <div class="flex items-center gap-3 rounded-2xl border border-primary-100 bg-white p-4">
            <span class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-primary-50 text-primary-600">
              <IconEl size={18} weight="bold" />
            </span>
            <span class="text-sm text-ink/70">{label}</span>
          </div>
        ))
      }
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-4 pb-16 text-center md:px-8 md:pb-20">
    <h2 class="text-2xl font-extrabold tracking-tight text-primary-900 md:text-3xl">Sudah Yakin? Amankan Slotmu Sekarang.</h2>
    <a
      href={waLink("Halo, saya mau daftar batch berikutnya di Kampung Cakap")}
      target="_blank"
      rel="noopener noreferrer"
      class="mt-6 inline-block rounded-full bg-cta px-7 py-3.5 text-sm font-bold text-white transition-transform active:scale-[0.98]"
    >
      Daftar Batch Berikutnya via WhatsApp
    </a>
  </section>
</Layout>
