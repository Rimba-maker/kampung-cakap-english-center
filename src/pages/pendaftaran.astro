---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/shared/PageHero.astro";
import { waLink, withBase } from "../lib/site";
import { photo } from "../lib/photos";
import { getUpcomingIntakes, formatIndoDate } from "../lib/intake-schedule";

const intakes = getUpcomingIntakes(2);
const dateValue = (date: Date) => `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, "0")}-${String(date.getDate()).padStart(2, "0")}`;
const steps = [
  { title: "Hubungi via WhatsApp", body: "Pilih program dan durasi yang sesuai dengan tujuanmu. Diskusikan juga kebutuhan asrama atau kos.", href: waLink("Halo, saya mau memilih program dan durasi di Kampung Cakap"), label: "Mulai konsultasi", external: true },
  { title: "Isi formulir pendaftaran", body: "Formulir pendaftaran dapat diisi online atau langsung di lokasi. Minta formulir dan petunjuk lengkap saat konsultasi.", href: withBase("/kontak/"), label: "Isi form konsultasi", external: false },
  { title: "Bayar DP minimal 50%", body: "DP mengunci slot batch pilihanmu. Pembayaran melalui transfer bank atau QRIS; pelunasan sebelum atau saat program dimulai.", href: withBase("/harga/"), label: "Baca rincian biaya", external: false },
  { title: "Datang pada tanggal intake", body: "Datang tanggal 10 atau 25 sesuai batch yang dipilih, lalu mulai orientasi dan kelas. Konfirmasi detail kedatangan sebelum berangkat.", href: withBase("/lokasi-wisata/"), label: "Lihat info lokasi", external: false },
];
---

<Layout title="Jadwal & Cara Daftar - Kampung Cakap English Center" description="Pendaftaran batch setiap tanggal 10 dan 25 tiap bulan. Cara daftar, syarat, dan yang perlu dibawa saat datang.">
  <PageHero title="Kapan Bisa Mulai?" subtitle="Intake reguler setiap tanggal 10 dan 25 tiap bulan. Pilih batch yang pas, siapkan kebutuhanmu, dan datang untuk mulai belajar." image={photo("arrival")} alt="Ilustrasi pelajar dengan barang bawaan saat tiba di lingkungan belajar" />

  <section class="section intake-section">
    <div class="container">
      <div class="intake-heading"><div><h2 class="section-heading">Dua kesempatan mulai setiap bulan.</h2><p class="section-intro">Daftar sebelum tanggal intake untuk ikut batch berikutnya. Tanggal di bawah mengikuti jadwal reguler, bukan konfirmasi ketersediaan slot.</p></div><a class="text-link" href={withBase("/program/")}>Belum memilih program?</a></div>
      <div class="intake-grid" id="upcoming-intakes">
        {intakes.map((date, index) => <article class="intake-option" data-intake-option>
          <h3>{index === 0 ? "Intake terdekat" : "Intake berikutnya"}</h3>
          <time datetime={dateValue(date)}>{formatIndoDate(date)}</time>
          <p>Orientasi & mulai kelas pada tanggal intake.</p>
          <a class:list={["btn", index === 0 ? "btn-primary" : "btn-secondary"]} data-intake-link href={waLink(`Halo, saya ingin daftar intake ${formatIndoDate(date)} di Kampung Cakap. Mohon info ketersediaan, program, dan biaya final.`)} target="_blank" rel="noopener noreferrer">Tanya batch ini</a>
        </article>)}
      </div>
      <p class="small-note">Tanggal dihitung otomatis dari jadwal tanggal 10 & 25. Konfirmasi ketersediaan sebelum mengatur perjalanan. Nomor WhatsApp masih demonstrasi.</p>
    </div>
  </section>

  <section class="section section-soft">
    <div class="container registration-layout">
      <div class="registration-intro"><h2 class="section-heading">Dari konsultasi sampai hari pertama.</h2><p class="section-intro">Empat langkah untuk mempersiapkan perjalanan belajarmu. Mulai dari program yang tepat, bukan dari buru-buru membayar.</p><figure><img class="photo" src={photo("conversation")} alt="Ilustrasi percakapan untuk merencanakan kegiatan belajar" width="1200" height="800" loading="lazy" /><figcaption>Foto Pexels sebagai ilustrasi percakapan, bukan dokumentasi proses pendaftaran.</figcaption></figure></div>
      <ol class="registration-steps">{steps.map((step, index) => <li><span class="step-number" aria-hidden="true">{index + 1}</span><div><h3>{step.title}</h3><p>{step.body}</p><a class="text-link" href={step.href} target={step.external ? "_blank" : undefined} rel={step.external ? "noopener noreferrer" : undefined}>{step.label}</a></div></li>)}</ol>
    </div>
  </section>

  <section class="section">
    <div class="container content-grid packing-section">
      <div><h2 class="section-heading">Bawa yang perlu, datang lebih siap.</h2><p class="section-intro">Siapkan dokumen pendaftaran dan kebutuhan pribadi sebelum berangkat.</p><ul class="packing-list"><li><h3>Fotokopi KTP / Kartu Pelajar</h3><p>Dokumen identitas untuk kebutuhan pendaftaran.</p></li><li><h3>Pas foto</h3><p>Konfirmasi ukuran dan jumlah yang diperlukan saat konsultasi.</p></li><li><h3>Perlengkapan pribadi untuk tinggal</h3><p>Jika mengambil asrama atau kos, bawa kebutuhan pribadi selama tinggal.</p></li></ul><a class="text-link" href={withBase("/asrama-english-area/")}>Cek fasilitas kamar & aturan tinggal</a></div>
      <div class="preparation-photos"><img class="photo" src={photo("notebook")} alt="Ilustrasi catatan dan perlengkapan untuk persiapan belajar" width="1200" height="800" loading="lazy" /><img class="photo" src={photo("dorm-study")} alt="Ilustrasi dua perempuan berbincang di kamar dengan ranjang susun" width="1200" height="800" loading="lazy" /><p class="small-note">Foto ilustrasi persiapan belajar dan tempat tinggal dari Pexels.</p></div>
    </div>
  </section>

  <section class="section section-soft"><div class="container cta-panel"><h2 class="section-heading">Mulai dengan satu percakapan.</h2><p class="section-intro">Sebutkan program, durasi, dan tanggal intake yang kamu inginkan. Pastikan biaya final dan detail kedatangan sudah jelas sebelum berangkat.</p><div class="closing-actions"><a class="btn btn-primary" href={waLink("Halo, saya mau daftar batch berikutnya di Kampung Cakap")} target="_blank" rel="noopener noreferrer">Daftar Batch Berikutnya via WhatsApp</a><a class="btn btn-secondary" href={withBase("/kontak/")}>Isi form konsultasi</a></div><p class="small-note">Situs ini menggunakan nomor WhatsApp demonstrasi. Kontak resmi, formulir pendaftaran resmi, dan detail pembayaran belum dikonfirmasi; jangan mengirim pembayaran atau dokumen identitas ke nomor demo.</p></div></section>
</Layout>

<script>
  import { getUpcomingIntakes, formatIndoDate } from "../lib/intake-schedule";
  import { waLink } from "../lib/site";

  // Refresh the static build's dates in the browser using the same intake source.
  const dates = getUpcomingIntakes(2);
  document.querySelectorAll<HTMLElement>("[data-intake-option]").forEach((option, index) => {
    const date = dates[index];
    const time = option.querySelector("time");
    const link = option.querySelector<HTMLAnchorElement>("[data-intake-link]");
    if (!date || !time || !link) return;
    const formatted = formatIndoDate(date);
    time.dateTime = `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, "0")}-${String(date.getDate()).padStart(2, "0")}`;
    time.textContent = formatted;
    link.href = waLink(`Halo, saya ingin daftar intake ${formatted} di Kampung Cakap. Mohon info ketersediaan, program, dan biaya final.`);
  });
</script>

<style>
  .intake-heading { display: flex; align-items: end; justify-content: space-between; gap: 32px; }
  .intake-heading > div { max-width: 780px; }
  .intake-heading > a { flex-shrink: 0; }
  .intake-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 28px; margin-top: 36px; }
  .intake-option { border: 1px solid #dce5eb; border-radius: 16px; padding: 32px; }
  .intake-option:first-child { background: #f4f9fc; }
  .intake-option h3 { color: #465966; font-size: 1rem; font-weight: 600; }
  .intake-option time { display: block; font-size: clamp(1.5rem, 2.6vw, 2rem); color: #07557c; font-weight: 700; letter-spacing: -.025em; line-height: 1.4; margin-top: 12px; }
  .intake-option p { margin: 14px 0 24px; line-height: 1.7; color: #465966; }
  .small-note, figcaption { color: #5a6b77; font-size: .8rem; line-height: 1.65; margin-top: 16px; }
  .registration-layout { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; align-items: start; }
  figure { margin: 28px 0 0; }
  figure img { aspect-ratio: 3 / 2; height: auto; }
  .registration-steps { list-style: none; padding: 0; margin: 0; }
  .registration-steps li { display: grid; grid-template-columns: 36px 1fr; gap: 18px; border-bottom: 1px solid #dce5eb; padding: 25px 0; }
  .registration-steps li:first-child { padding-top: 0; }
  .step-number { display: grid; place-items: center; width: 36px; height: 36px; border-radius: 50%; background: #e8f5fc; color: #07557c; font-size: .9rem; font-weight: 700; }
  .registration-steps h3 { font-size: 1.15rem; color: #172b3a; font-weight: 700; }
  .registration-steps p { margin: 8px 0 14px; color: #465966; line-height: 1.75; }
  .packing-section { align-items: start; }
  .packing-list { list-style: none; padding: 0; margin: 26px 0; }
  .packing-list li { padding: 20px 0; border-bottom: 1px solid #dce5eb; }
  .packing-list h3 { color: #172b3a; font-size: 1rem; font-weight: 700; }
  .packing-list p { color: #465966; line-height: 1.7; margin-top: 8px; }
  .preparation-photos { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .preparation-photos img { aspect-ratio: 3 / 4; height: 100%; }
  .preparation-photos p { grid-column: 1 / -1; margin-top: 0; }
  .closing-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 26px; }
  @media (max-width: 900px) { .intake-heading { display: block; } .intake-heading > a { display: inline-block; margin-top: 20px; } .registration-layout { gap: 36px; } }
  @media (max-width: 767px) { .intake-grid, .registration-layout { grid-template-columns: 1fr; gap: 28px; } .intake-option { padding: 24px; } .registration-steps li { gap: 14px; } }
</style>
