---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/shared/PageHero.astro";
import { waLink, withBase } from "../lib/site";
import { photo } from "../lib/photos";

const tiers = [
  { id: "confidence", title: "Confidence", starting: "Mulai dari nol", duration: "2–4 minggu", image: "classroom", alt: "Ilustrasi peserta belajar bersama di ruang kelas", description: "Untuk yang belum punya dasar sama sekali atau masih grogi ngomong bahasa Inggris.", materials: ["Grammar dasar", "Vocabulary dasar", "Basic Conversation", "Pronunciation dasar"], target: "Berani ngomong kalimat sederhana tanpa takut salah." },
  { id: "active", title: "Active", starting: "Sudah punya dasar", duration: "4–8 minggu", image: "discussion", alt: "Ilustrasi kelompok pelajar berdiskusi bersama", description: "Untuk yang sudah bisa dasar, tapi ingin lebih lancar dan percaya diri.", materials: ["Grammar for Speaking", "Active Conversation", "Listening", "Vocabulary in Context"], target: "Bisa ngobrol natural dalam berbagai topik sehari-hari." },
  { id: "fluent-toefl", title: "Fluent & TOEFL Prep", starting: "Menuju konteks akademik & profesional", duration: "4–8 minggu", image: "toefl", alt: "Ilustrasi belajar dengan buku untuk persiapan ujian", description: "Untuk yang ingin lancar total atau butuh skor TOEFL untuk kuliah dan kerja.", materials: ["Advanced Speaking", "TOEFL ITP (Structure, Listening, Reading)", "Academic Writing", "Syntax"], target: "Skor TOEFL kompetitif dan speaking lancar untuk konteks formal." },
  { id: "micro-teaching", title: "Micro Teaching", starting: "Lanjutan untuk calon pengajar", duration: "2–4 minggu", image: "workshop", alt: "Ilustrasi sesi belajar dan presentasi dalam kelompok", description: "Untuk yang sudah fluent dan tertarik jadi tutor atau pengajar.", materials: ["Teknik mengajar", "Public speaking", "Lesson planning"], target: "Siap mengajar bahasa Inggris tingkat dasar–menengah." },
 ] as const;
const thematicClasses = ["Speaking Intensive", "Grammar", "Thematic Vocabulary", "Listening", "Reading", "Writing", "Pronunciation Clinic"];
---

<Layout title="Program Kursus Bahasa Inggris - Kampung Cakap" description="Program Confidence, Active, Fluent & TOEFL Prep, hingga Micro Teaching. Jenjang belajar bahasa Inggris yang jelas dan terstruktur.">
  <PageHero title="Jenjang Belajar Yang Jelas, Dari Nol Sampai Mahir." subtitle="Setiap jenjang membangun kemampuan secara bertahap. Mulai dari kemampuanmu sekarang, lalu belajar menuju tujuan yang kamu pilih." image={photo("speaking")} alt="Ilustrasi pelajar berlatih berbicara bersama" />

  <section class="section journey-overview">
    <div class="container">
      <div class="overview-heading">
        <div><h2 class="section-heading">Temukan titik mulainya.</h2><p class="section-intro">Belum pernah belajar atau sudah siap mengajar? Empat jenjang ini memberi arah yang jelas. Pilih untuk melihat materi, durasi, dan targetnya.</p></div>
        <a class="text-link" href={withBase("/harga/")}>Bandingkan biaya & durasi</a>
      </div>
      <nav class="journey-nav" aria-label="Jenjang program">
        {tiers.map((tier, index) => <a href={`#${tier.id}`}><span class="journey-step">{index + 1}</span><strong>{tier.title}</strong><span>{tier.starting}</span><span class="journey-duration">{tier.duration}</span></a>)}
      </nav>
      <p class="small-note">Durasi adalah panduan belajar; target program bukan jaminan hasil atau skor TOEFL tertentu.</p>
    </div>
  </section>

  <section class="section section-soft journey-details" aria-label="Detail jenjang belajar">
    <div class="container">
      {tiers.map((tier, index) => <article id={tier.id} class:list={["level", { "level-reverse": index % 2 === 1 }]}>
        <div class="level-image"><img class="photo" src={photo(tier.image)} alt={tier.alt} width="1200" height="800" loading="lazy" /><p class="small-note">Foto ilustrasi pengalaman belajar, bersumber dari Pexels.</p></div>
        <div class="level-copy">
          <h2>{tier.title}</h2>
          <div class="level-meta"><span>{tier.starting}</span><span class="tag">{tier.duration}</span></div>
          <p class="level-description">{tier.description}</p>
          <h3>Yang akan kamu pelajari</h3>
          <ul class="materials">{tier.materials.map((material) => <li>{material}</li>)}</ul>
          <div class="target"><h3>Target belajar</h3><p>{tier.target}</p></div>
          <a class="text-link" href={waLink(`Halo, saya ingin konsultasi program ${tier.title} di Kampung Cakap`)} target="_blank" rel="noopener noreferrer">Tanya program {tier.title}</a>
        </div>
      </article>)}
    </div>
  </section>

  <section class="section">
    <div class="container content-grid thematic-section">
      <div><h2 class="section-heading">Tambahkan fokus yang kamu butuhkan.</h2><p class="section-intro">Kelas tematik bisa diambil terpisah atau sebagai pelengkap program utama. Fokuskan latihan pada kemampuan yang ingin kamu tingkatkan.</p><ul class="thematic-list">{thematicClasses.map((name) => <li>{name}</li>)}</ul><a class="text-link" href={waLink("Halo, saya ingin tanya kelas tematik Kampung Cakap")} target="_blank" rel="noopener noreferrer">Konsultasi kelas tematik</a></div>
      <div class="thematic-photos"><img class="photo" src={photo("reading")} alt="Ilustrasi pelajar membaca buku" width="1200" height="800" loading="lazy" /><img class="photo" src={photo("notebook")} alt="Ilustrasi buku catatan untuk latihan menulis" width="1200" height="800" loading="lazy" /><p class="small-note">Foto Pexels sebagai ilustrasi, bukan dokumentasi kelas Kampung Cakap.</p></div>
    </div>
  </section>

  <section class="section section-soft"><div class="container cta-panel"><h2 class="section-heading">Kamu tidak harus menentukan sendiri.</h2><p class="section-intro">Ceritakan kemampuanmu sekarang dan tujuan belajarmu. Mulai konsultasi untuk memilih jenjang dan durasi yang sesuai.</p><div class="closing-actions"><a class="btn btn-primary" href={waLink("Halo, saya mau konsultasi pilih program yang tepat di Kampung Cakap")} target="_blank" rel="noopener noreferrer">Konsultasi Pilih Program</a><a class="btn btn-secondary" href={withBase("/pendaftaran/")}>Lihat jadwal intake</a></div><p class="small-note">Tautan WhatsApp menggunakan nomor demonstrasi; kontak resmi belum dikonfirmasi.</p></div></section>
</Layout>

<style>
  .overview-heading { display: flex; align-items: end; justify-content: space-between; gap: 32px; }
  .overview-heading > div { max-width: 760px; }
  .overview-heading > a { flex-shrink: 0; }
  .journey-nav { display: grid; grid-template-columns: repeat(4, 1fr); margin-top: 36px; border-top: 1px solid #dce5eb; border-bottom: 1px solid #dce5eb; }
  .journey-nav a { display: flex; flex-direction: column; gap: 9px; padding: 26px 22px; color: #172b3a; text-decoration: none; }
  .journey-nav a + a { border-left: 1px solid #dce5eb; }
  .journey-nav a:hover { background: #f4f9fc; }
  .journey-nav strong { font-size: 1.1rem; }
  .journey-nav a > span:not(.journey-step) { font-size: .875rem; color: #465966; }
  .journey-step { color: #07557c; font-weight: 700; }
  .journey-duration { margin-top: auto; padding-top: 14px; }
  .small-note { color: #5a6b77; font-size: .8rem; line-height: 1.65; margin-top: 16px; }
  .level { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; align-items: start; scroll-margin-top: 110px; }
  .level + .level { margin-top: 76px; padding-top: 76px; border-top: 1px solid #dce5eb; }
  .level-reverse .level-image { order: 2; }
  .level-image img { aspect-ratio: 5 / 4; height: auto; }
  .level-copy h2 { font-size: clamp(1.8rem, 3vw, 2.65rem); letter-spacing: -.03em; line-height: 1.2; color: #172b3a; }
  .level-meta { display: flex; align-items: center; flex-wrap: wrap; gap: 12px; margin-top: 14px; color: #07557c; font-size: .9rem; }
  .level-description { margin: 22px 0; color: #465966; line-height: 1.75; }
  .level-copy h3 { font-size: .95rem; font-weight: 700; color: #172b3a; }
  .materials { padding-left: 20px; margin: 12px 0 24px; color: #465966; line-height: 1.8; }
  .target { padding: 20px 0; border-top: 1px solid #dce5eb; margin-bottom: 14px; }
  .target p { margin-top: 8px; color: #465966; line-height: 1.7; }
  .thematic-section { align-items: start; }
  .thematic-list { list-style: none; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 0 24px; margin: 28px 0; }
  .thematic-list li { border-bottom: 1px solid #dce5eb; padding: 12px 0; color: #172b3a; }
  .thematic-photos { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .thematic-photos img { aspect-ratio: 3 / 4; height: 100%; }
  .thematic-photos p { grid-column: 1 / -1; margin-top: 0; }
  .closing-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 26px; }
  @media (max-width: 900px) { .overview-heading { display: block; } .overview-heading > a { display: inline-block; margin-top: 20px; } .level { gap: 32px; } }
  @media (max-width: 767px) { .journey-nav { grid-template-columns: 1fr 1fr; } .journey-nav a { padding: 20px 16px; } .journey-nav a:nth-child(3) { border-left: 0; } .journey-nav a:nth-child(n+3) { border-top: 1px solid #dce5eb; } .level { grid-template-columns: 1fr; gap: 24px; } .level-reverse .level-image { order: 0; } .level + .level { padding-top: 48px; margin-top: 48px; } .level-image img { aspect-ratio: 3 / 2; } .thematic-list { grid-template-columns: 1fr; } }
</style>
